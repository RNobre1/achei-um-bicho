{
  "expo": {
    "name": "Achei um Bicho",
    "slug": "achei-um-bicho",
    "scheme": "acheiumbicho",
    "version": "0.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF2EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.ufopa.acheiumbicho"
    },
    "android": {
      "package": "br.ufopa.acheiumbicho",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Achei um Bicho usa sua localização para mostrar os casos perto de você."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Achei um Bicho usa suas fotos para mostrar o animal no caso que você publica.",
          "cameraPermission": "O Achei um Bicho usa a câmera para fotografar o animal que você achou ou perdeu.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8383a0d-08ce-43de-8335-fa8bd47ae5df"
      }
    },
    "owner": "acheiumbicho"
  }
}
