# Copie para .env. Variáveis EXPO_PUBLIC_ vão para dentro do aplicativo:
# nunca coloque segredo aqui.

# endereço da API; no celular físico use o IP da máquina na rede, não localhost
EXPO_PUBLIC_API_URL=http://localhost:3333

# servidor de ladrilhos do mapa da área aproximada; o padrão é o do OpenStreetMap,
# que pede atribuição visível (o mapa já mostra) e uso moderado
EXPO_PUBLIC_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
