# Copie para .env e ajuste. O .env nunca vai para o repositório.

# banco do contêiner (docker compose up -d banco)
DATABASE_URL=postgresql://bicho:bicho@localhost:5432/achei_um_bicho

PORT=3333

# origens que podem chamar a API; separe várias por vírgula
CORS_ORIGINS=http://localhost:8081

# raio inicial do mural, em metros; precisa ficar entre 500 e 5000
RAIO_PADRAO_METROS=1600

# teto de distância, em metros, para um caso virar candidato de outro (RN7)
RAIO_MAXIMO_PAREAMENTO_METROS=5000

# dias sem interação até pedir confirmação ao autor
DIAS_ATE_COBRANCA=9

# dias sem interação até retirar o caso do mural
DIAS_ATE_EXPIRAR=15

# segredo para acionar a tarefa diária de ciclo de vida
TAREFAS_CHAVE=

# segredo para HMAC dos códigos de edição de quem publica sem conta
CODIGO_SEGREDO=segredo-local-desenvolvimento
