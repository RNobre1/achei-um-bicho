# Copie para .env e ajuste. O .env nunca vai para o repositório.

# banco do contêiner (docker compose up -d banco)
DATABASE_URL=postgresql://bicho:bicho@localhost:5432/achei_um_bicho

PORT=3333

# origens que podem chamar a API; separe várias por vírgula
CORS_ORIGINS=http://localhost:8081

# raio inicial do mural, em metros; precisa ficar entre 500 e 5000
RAIO_PADRAO_METROS=1600
