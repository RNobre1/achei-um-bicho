{
  "name": "@achei/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Achei um Bicho",
  "scripts": {
    "prebuild": "pnpm --filter @achei/contratos build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "predev": "pnpm --filter @achei/contratos build",
    "dev": "nest start --watch",
    "test": "vitest run && vitest run -c vitest.int.config.ts",
    "test:unidade": "vitest run",
    "test:integracao": "vitest run -c vitest.int.config.ts",
    "gerar:vocabulario": "tsx prisma/gerar-vocabulario.ts",
    "semear:demo": "tsx scripts/semear-demo.ts"
  },
  "dependencies": {
    "@achei/contratos": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.1",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
